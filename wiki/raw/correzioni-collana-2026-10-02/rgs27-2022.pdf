				<div class="modal-footer">
					<button id="AcceptAllCookiesModal" name="AcceptAll" type="button" class="btn  rounded-pill btn-primary shadow" title="Accetta tutti i cookie" aria-label="Accetta tutti i cookie" onclick="setAcceptAllPreferencesAsCookie()" >
						<span>Accetta tutti i cookie</span>
