    },
    {
      "nucleusId": "N-TR01-01-03",
      "evidenceQuote": "Il campione comprende comuni, provincia, università, ente regionale e agenzia digitale. Questa varietà permette di distinguere almeno quattro contesti.",
      "sourceLocation": "chapters/01-lavorare-ict-pa-ruoli-enti-prove.md#n-tr01-01-03",
      "sourceRef": "sources/campione-bandi-ict-pa-vol-08-2024-2026",
