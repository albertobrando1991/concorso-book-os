    {
      "nucleusId": "N-TR01-01-04",
      "evidenceQuote": "Leggi avviso, allegati e comunicazioni ufficiali. Estrai denominazione, attività, requisiti, materie, prove e criteri. Mantieni separato ciò che permette di partecipare da ciò che sarà valutato.",
      "sourceLocation": "chapters/01-lavorare-ict-pa-ruoli-enti-prove.md#n-tr01-01-04",
      "sourceRef": "sources/campione-bandi-ict-pa-vol-08-2024-2026",
